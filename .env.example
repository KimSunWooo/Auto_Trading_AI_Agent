LLM_READ_TIMEOUT=45
LLM_TOTAL_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RPS=1
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN=45

# Observation capital profile (NOT a real brokerage account)
OBSERVATION_TOTAL_CAPITAL=100000000
OBSERVATION_AI_CAPITAL_LIMIT=10000000

# AI Investment Agent — environment variable names only. Never commit real secrets.

# Runtime
AI_DATA_MODE=FIXTURE
# AI_DATA_MODE=LIVE_OBSERVATION

# Market (read-only JSON feed). No order endpoints.
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_CONNECT_TIMEOUT=3
MARKET_DATA_READ_TIMEOUT=10
MARKET_DATA_TOTAL_TIMEOUT=15
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_RPS=2
MARKET_DATA_CIRCUIT_FAILURES=5
MARKET_DATA_CIRCUIT_COOLDOWN=30

# OpenDART (disclosure query only)
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_CORP_CODE=
DART_CORP_CODE_005930=
DART_CONNECT_TIMEOUT=3
DART_READ_TIMEOUT=10
DART_TOTAL_TIMEOUT=15
DART_MAX_RETRIES=3
DART_RPS=1
DART_CIRCUIT_FAILURES=5
DART_CIRCUIT_COOLDOWN=60

# Macro / official economic JSON feed
MACRO_BASE_URL=
MACRO_API_KEY=
MACRO_CONNECT_TIMEOUT=3
MACRO_READ_TIMEOUT=10
MACRO_TOTAL_TIMEOUT=15
MACRO_MAX_RETRIES=3
MACRO_RPS=1
MACRO_CIRCUIT_FAILURES=5
MACRO_CIRCUIT_COOLDOWN=60

# News wire / media JSON feed
NEWS_BASE_URL=
NEWS_API_KEY=
NEWS_CONNECT_TIMEOUT=3
NEWS_READ_TIMEOUT=10
NEWS_TOTAL_TIMEOUT=15
NEWS_MAX_RETRIES=3
NEWS_RPS=1
